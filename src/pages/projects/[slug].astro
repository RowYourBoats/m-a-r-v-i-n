---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import manifest from "@/data/manifest.json";
import projectsData from "@/data/projects.json";
import { getProjectDoc } from "@/lib/project-doc";
import { orderItems } from "@/lib/order-items";

const { slug } = Astro.params;
const { projects, items: allManifestItems } = manifest as any;

// Doc projects are sourced from projects.json, which always has the _project.md
// entry — so an image-less project still resolves rather than redirecting on a
// missing manifest entry.
const projectFull = (projectsData as any)[slug!];

// Two render modes, in precedence order:
//   1. Markdown doc — _project.md body with `layout: doc` (see project-doc.ts)
//   2. Media grid   — the default
const mdDoc = await getProjectDoc(projectFull?.image_folders);

const project = projects[slug!];
if (!mdDoc && (!project || project.snapshot_only)) return Astro.redirect("/work");

// manifest.projects drops `image_folders`, so the tier (work / practice /
// tools / teaching) comes from projects.json. Each tier lights up its own nav
// item; everything else belongs to /work.
const tier = projectFull?.image_folders?.[0]?.split("/")[0] ?? "work";
const navSection = tier === "practice" ? "practice" : tier === "tools" ? "tools" : "work";

const pageTitle = `${mdDoc ? projectFull.name : project.title} — Marvin de Jong`;

// Order media by the explicit `order` list from _project.md (surfaced through
// projects.json by build-projects.mjs), then alphabetically by filename/title.
// Same rule as essays (see src/lib/order-items.ts) so the two stay consistent.
const items = orderItems(
  allManifestItems.filter((i: any) => i.project === slug),
  (project && project.order) || [],
);

// Tag frequency across items in this project → main tag + other tags
const tagCounts = new Map<string, number>();
for (const it of items) {
  for (const t of (it.tags || [])) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
}
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).map(([t]) => t);
const mainTag = sortedTags[0] || null;

// Project-page videos: strip `background=1` from the URL so Vimeo's player
// chrome (play/pause, mute/unmute, fullscreen) appears. The grid embeds these
// same items in background mode for the autoplay-muted-loop feel; here we
// want them controllable. autoplay/muted/loop/playsinline are preserved.
const toUIVideoUrl = (url: string) => {
  if (!url) return url;
  const [base, query = ""] = url.split("?");
  const params = query.split("&").filter((p) => p && !p.startsWith("background="));
  return params.length ? `${base}?${params.join("&")}` : base;
};

// 2 related items from OTHER projects sharing the main tag
const allItems = (manifest as any).items as any[];
let related: any[] = [];
if (mainTag) {
  related = allItems
    .filter((i) => i.project !== slug && i.type === "image" && i.src && (i.tags || []).includes(mainTag))
    .sort(() => Math.random() - 0.5)
    .slice(0, 2);
}
---

<Base title={pageTitle} section={navSection}>
  {mdDoc ? (
    <article class="appdoc-page">
      <header class="project-header">
        <h1>{projectFull.name}</h1>
        {projectFull.description && (
          <div class="description">
            {projectFull.description.split(/\n\s*\n/).map((para: string) => (
              <p>{para.trim()}</p>
            ))}
          </div>
        )}
      </header>

      <div class="prose projectdoc" set:html={mdDoc.html} />

      {projectFull.credits && projectFull.credits.length > 0 && (
        <div class="detail-credits">
          {projectFull.credits.map((c: any) => (
            <div><span class="detail-credit-role">{c.role}</span> {c.name}</div>
          ))}
        </div>
      )}
    </article>
  ) : (
    <Fragment>
      <header class="project-header">
        <h1>{project.title}</h1>
        {project.description && (
          <div class="description">
            {project.description.split(/\n\s*\n/).map((para: string) => (
              <p>{para.trim()}</p>
            ))}
          </div>
        )}
        {project.client && <p class="detail-meta">{project.client}{project.year ? ` — ${project.year}` : ""}</p>}
      </header>

      <div class="project-media">
        {items.map((item) => (
          <figure class="project-media-item" data-id={item.id}>
            {item.type === "video" ? (
              <div
                class="project-media-frame"
                style={item.width && item.height ? `aspect-ratio: ${item.width} / ${item.height}` : undefined}
              >
                <iframe src={toUIVideoUrl(item.video)} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
              </div>
            ) : item.width && item.height ? (
              <Image
                src={item.src}
                width={item.width}
                height={item.height}
                widths={[768, 1200, 1920, 2400]}
                sizes="100vw"
                alt={item.description || item.title}
                loading="lazy"
              />
            ) : (
              <img src={item.src} alt={item.description || item.title} loading="lazy" />
            )}
            {item.title && <figcaption class="label">{item.title}</figcaption>}
          </figure>
        ))}
      </div>

      {project.credits && project.credits.length > 0 && (
        <div class="detail-credits">
          {project.credits.map((c: any) => (
            <div><span class="detail-credit-role">{c.role}</span> {c.name}</div>
          ))}
        </div>
      )}

      {mainTag && related.length > 0 && (
        <section>
          <p class="detail-meta">More {mainTag}</p>
          <div class="detail-related">
            {related.map((s) => (
              <a href={`/projects/${s.project}`}>
                {s.width && s.height ? (
                  <Image
                    src={s.src}
                    width={s.width}
                    height={s.height}
                    widths={[300, 600, 900]}
                    sizes="300px"
                    alt={s.description || s.title}
                    class="detail-related-thumb"
                    loading="lazy"
                  />
                ) : (
                  <img src={s.src} alt={s.description || s.title} class="detail-related-thumb" loading="lazy" />
                )}
              </a>
            ))}
          </div>
        </section>
      )}
    </Fragment>
  )}
</Base>

<script>
  // Mount any inline animated diagrams (```diagram fences in a markdown doc).
  // No-op on media / HTML-doc pages, which have no [data-diagram] placeholders.
  import { mountAll } from "@/components/diagrams/registry";
  mountAll();
</script>
