---
import { getEntry } from "astro:content";
import Base from "@/layouts/Base.astro";

const { slug } = Astro.params;
const entry = await getEntry("diagrams", slug!);
if (!entry) return Astro.redirect("/work");

const { title, caption, component, project_keys = [] } = entry.data;

// Eagerly load every diagram component once; pick the matching one by name.
const components = import.meta.glob("@/components/diagrams/*.astro", { eager: true }) as Record<
  string,
  { default: any }
>;
const componentPath = `/src/components/diagrams/${component}.astro`;
const Component = components[componentPath]?.default;

if (!Component) {
  throw new Error(`Diagram component not found: ${component} (looked for ${componentPath})`);
}
---

<Base title={`${title} — Marvin de Jong`}>
  <article class="diagram-page">
    <header class="diagram-page-header">
      <h1>{title}</h1>
    </header>

    <Component />

    <p class="diagram-page-caption">{caption}</p>

    {project_keys.length > 0 && (
      <nav class="diagram-page-projects">
        <span>From:</span>
        {project_keys.map((key) => (
          <a href={`/projects/${key}`}>{key}</a>
        ))}
      </nav>
    )}
  </article>
</Base>

<style>
  .diagram-page {
    display: flex;
    flex-direction: column;
    gap: var(--pad);
  }
  .diagram-page-header h1 {
    font-size: var(--fs-body);
    font-weight: 400;
  }
  .diagram-page-caption {
    font-size: var(--fs-secondary);
    line-height: 1.3;
    max-width: 60ch;
  }
  .diagram-page-projects {
    display: flex;
    gap: var(--pad-sm);
    font-size: var(--fs-secondary);
  }
  .diagram-page-projects a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .diagram-page-projects a:hover {
    text-decoration: underline;
  }
</style>
