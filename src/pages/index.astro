---
import Base from "@/layouts/Base.astro";
import Filmstrip from "@/components/Filmstrip.astro";
import { SITE_LINKS } from "@/lib/site-links";
import { getEntry, render } from "astro:content";

const entry = await getEntry("pages", "marvin");
const { Content } = await render(entry!);
const sections = entry?.data.sections ?? [];
// Only render the lead wrapper if the markdown body has actual content —
// otherwise the empty .editorial-lead is still a flex child and the
// .editorial gap lands above the first section, doubling the top space.
const hasLead = !!entry?.body && entry.body.trim().length > 0;
---

<Base title="Marvin de Jong">
  <div class="editorial">
    {hasLead && (
      <div class="prose editorial-lead">
        <Content />
      </div>
    )}

    {sections.map((section) => {
      if (section.kind === "text") {
        return <p class="prose-line">{section.body}</p>;
      }
      if (section.kind === "filmstrip") {
        return <Filmstrip assets={section.assets} />;
      }
      if (section.kind === "link") {
        return <p class="prose-line"><a href={section.href}>{section.label}</a></p>;
      }
      if (section.kind === "contact") {
        return (
          <div class="contact-lines">
            {SITE_LINKS.map((link) => (
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener" : undefined}
              >{link.label}</a>
            ))}
          </div>
        );
      }
      return null;
    })}
  </div>
</Base>
