---
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import { getEntry, render } from "astro:content";
import manifest from "@/data/manifest.json";
import { orderItems } from "@/lib/order-items";

const { slug } = Astro.params;
const entry = await getEntry("writing", slug!);

if (!entry) return Astro.redirect("/practice");

const { Content } = await render(entry);

// Images referenced inline in the body by bare filename — `![cap](file.png)`.
// remark-essay-images.mjs swaps those filenames for Blob URLs at render time;
// here we read the same references so an inline image isn't ALSO repeated in
// the side rail. (Absolute/rooted/remote srcs are ignored — they're not
// companion files.)
const inlineNames = new Set(
  [...(entry as any).body.matchAll(/!\[[^\]]*\]\(([^)\s]+)\)/g)]
    .map((m: any) => m[1] as string)
    .filter((u: string) => !/^(?:https?:|\/)/.test(u) && !u.includes("/")),
);

// Companion images flagged essay_of for this essay (built by build-manifest
// for every image sharing the essay's folder), minus any pulled inline above.
// The side rail is unchanged; an image referenced inline simply moves there
// instead of duplicating, so the rail can hold its own (small) images while
// wider ones run inline in the text column.
// Two-column layout shows the text alongside these figures; falls back to
// single-column when none.
// Ordered like project media: optional `order` list in the essay frontmatter,
// then alphabetical by filename (so numbered prefixes 00-, 01- … sort right).
const figures = orderItems(
  (manifest.items as any[]).filter(
    (i) => i.essay_of === entry.id && !inlineNames.has(i.src.split("/").pop()),
  ),
  entry.data.order || [],
);
---

<Base title={`${entry.data.title} — Marvin de Jong`}>
  <article class={`essay${figures.length ? " essay--with-figures" : ""}`}>
    <div class="essay-text">
      <header class="essay-header">
        <h1 class="essay-title">{entry.data.title}</h1>
        {entry.data.date && <p class="essay-date">{entry.data.date}</p>}
      </header>
      <div class="prose">
        <Content />
      </div>
    </div>
    {figures.length > 0 && (
      <div class="essay-figures">
        {figures.map((f: any) => (
          <figure class="essay-figure">
            {f.width && f.height ? (
              <Image
                src={f.src}
                width={f.width}
                height={f.height}
                widths={[480, 768, 1200]}
                sizes="(max-width: 760px) 100vw, 50vw"
                alt={f.description || f.title || ""}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <img
                src={f.src}
                alt={f.description || f.title || ""}
                loading="lazy"
                decoding="async"
              />
            )}
            {f.description && <figcaption>{f.description}</figcaption>}
          </figure>
        ))}
      </div>
    )}
  </article>
</Base>
