---
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import { getEntry, render } from "astro:content";
import manifest from "@/data/manifest.json";

const { slug } = Astro.params;
const entry = await getEntry("writing", slug!);

if (!entry) return Astro.redirect("/practice");

const { Content } = await render(entry);

// Companion images flagged essay_of for this essay (built by build-manifest
// for every image sharing the essay's folder). Two-column layout shows the
// text alongside these figures; falls back to single-column when none.
const figures = (manifest.items as any[]).filter((i) => i.essay_of === entry.id);
---

<Base title={`${entry.data.title} — Marvin de Jong`}>
  <article class={`essay${figures.length ? " essay--with-figures" : ""}`}>
    <div class="essay-text">
      <header class="essay-header">
        <h1 class="essay-title">{entry.data.title}</h1>
        {entry.data.date && <p class="essay-date">{entry.data.date}</p>}
      </header>
      <div class="prose">
        <Content />
      </div>
    </div>
    {figures.length > 0 && (
      <div class="essay-figures">
        {figures.map((f: any) => (
          <figure class="essay-figure">
            {f.width && f.height ? (
              <Image
                src={f.src}
                width={f.width}
                height={f.height}
                widths={[480, 768, 1200]}
                sizes="(max-width: 760px) 100vw, 50vw"
                alt={f.description || f.title || ""}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <img
                src={f.src}
                alt={f.description || f.title || ""}
                loading="lazy"
                decoding="async"
              />
            )}
            {f.description && <figcaption>{f.description}</figcaption>}
          </figure>
        ))}
      </div>
    )}
  </article>
</Base>
