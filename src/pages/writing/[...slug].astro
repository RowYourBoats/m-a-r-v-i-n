---
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import { getEntry, render } from "astro:content";
import manifest from "@/data/manifest.json";
import { orderItems } from "@/lib/order-items";
import { formatInline } from "@/lib/format-inline";

const { slug } = Astro.params;
const entry = await getEntry("writing", slug!);

if (!entry) return Astro.redirect("/practice");

const { Content } = await render(entry);

// Images referenced inline in the body by bare filename — `![cap](file.png)`.
// remark-essay-images.mjs swaps those filenames for Blob URLs at render time;
// here we read the same references so an inline image isn't ALSO repeated in
// the side rail. (Absolute/rooted/remote srcs are ignored — they're not
// companion files.)
const inlineNames = new Set(
  [...(entry as any).body.matchAll(/!\[[^\]]*\]\(([^)\s]+)\)/g)]
    .map((m: any) => m[1] as string)
    .filter((u: string) => !/^(?:https?:|\/)/.test(u) && !u.includes("/")),
);

// Companion images flagged essay_of for this essay (built by build-manifest
// for every image sharing the essay's folder), minus any pulled inline above.
// The side rail is unchanged; an image referenced inline simply moves there
// instead of duplicating, so the rail can hold its own (small) images while
// wider ones run inline in the text column.
// Two-column layout shows the text alongside these figures; falls back to
// single-column when none.
// Ordered like project media: optional `order` list in the essay frontmatter,
// then alphabetical by filename (so numbered prefixes 00-, 01- … sort right).
// Companion media for this essay: images AND videos flagged essay_of (built by
// build-manifest — images from the folder, videos from `videos:` frontmatter).
// Inline-image dedup applies only to images (videos have no `src`/filename, so
// they always pass). Featured background videos are pulled out to render
// full-bleed; the rest flow through the rail/gallery in `order`.
const figures = orderItems(
  (manifest.items as any[]).filter(
    (i) =>
      i.essay_of === entry.id &&
      (i.type === "video" || !inlineNames.has((i.src || "").split("/").pop())),
  ),
  entry.data.order || [],
);

// gallery figures are ~1/3 vw on desktop; the standard rail keeps its 50vw
// hint. Narrow the hint only for gallery so srcset picks a right-sized source.
const figureSizes =
  entry.data.layout === "gallery"
    ? "(max-width: 680px) 50vw, 33vw"
    : "(max-width: 760px) 100vw, 50vw";
---

<Base title={`${entry.data.title} — Marvin de Jong`}>
  <article class={`essay${figures.length ? " essay--with-figures" : ""}${
    figures.length && entry.data.layout === "gallery" ? " essay--gallery" : ""
  }`}>
    <div class="essay-text">
      <header class="essay-header">
        <h1 class="essay-title">{entry.data.title}</h1>
        {entry.data.date && <p class="essay-date">{entry.data.date}</p>}
        {entry.data.client && <p class="essay-date essay-publication">{entry.data.client}</p>}
      </header>
      <div class="prose">
        <Content />
      </div>
      {entry.data.credits && entry.data.credits.length > 0 && (
        <div class="detail-credits">
          {entry.data.credits.map((c: any) => (
            <div><span class="detail-credit-role">{c.role}</span> {c.name}</div>
          ))}
        </div>
      )}
    </div>
    {figures.length > 0 && (
      <div class="essay-figures">
        {figures.map((f: any) => (
          <figure class={`essay-figure${f.type === "video" && f.featured ? " essay-figure--featured" : ""}`}>
            {f.type === "video" ? (
              <div
                class="essay-video"
                style={f.width && f.height ? `aspect-ratio: ${f.width} / ${f.height}` : "aspect-ratio: 16 / 9"}
              >
                <iframe
                  src={f.video}
                  loading="lazy"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                  title={f.title || ""}
                ></iframe>
              </div>
            ) : f.width && f.height ? (
              <Image
                src={f.src}
                width={f.width}
                height={f.height}
                widths={[480, 768, 1200]}
                sizes={figureSizes}
                alt={f.description || f.title || ""}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <img
                src={f.src}
                alt={f.description || f.title || ""}
                loading="lazy"
                decoding="async"
              />
            )}
            {f.description && (
              <figcaption set:html={formatInline(f.description)} />
            )}
          </figure>
        ))}
      </div>
    )}
  </article>
</Base>

<script>
  // Mount any inline animated diagrams (```diagram fences). Now that
  // remark-diagram is in the global markdown config, essay bodies can carry them
  // too — same client registry the project doc pages use. No-op when there are
  // no [data-diagram] placeholders.
  import { mountAll } from "@/components/diagrams/registry";
  mountAll();
</script>
