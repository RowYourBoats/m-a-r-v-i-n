---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import manifest from "@/data/manifest.json";
import { getCollection } from "astro:content";

const { items } = manifest;
const personalItems = items.filter((item) => item.personal);

// Only show essays from practice/ projects on this page
const allWriting = await getCollection("writing");
const writingEntries = allWriting.filter((e) => e.id.startsWith("practice/"));

// Light tag set for Practice — union of tags actually present on essays
// and personal items. Dedupe and drop noisy ones.
const tagSet = new Set<string>();
for (const item of personalItems) {
  for (const t of item.tags || []) tagSet.add(t);
}
for (const entry of writingEntries) {
  for (const t of entry.data.tags || []) tagSet.add(t);
}
tagSet.delete("snapshot"); // implicit — all loose personal images have it
const practiceTags = [...tagSet].sort();
---

<Base title="Practice — Marvin de Jong">
  <p class="page-intro">In Marvin's practice he's exploring parameter-driven graphic design, color, form, composition as controlled instability. A person moves, a knob turns, a button is pressed, it's getting darker, and the design changes.</p>

  <div class="filter-bar" id="filters">
    <button data-filter="all" aria-pressed="true">All</button>
    {practiceTags.map((tag) => (
      <button data-tag={tag} aria-pressed="false">{tag}</button>
    ))}
  </div>

  <div class="grid" id="grid">
    {writingEntries.map((entry) => (
      <div
        class="grid-item grid-item--writing"
        data-id={`writing-${entry.id}`}
        data-tags={(entry.data.tags || []).join(",")}
        data-type="writing"
        data-excerpt={entry.data.excerpt || ""}
        data-slug={entry.id}
      >
        <div class="writing-card">
          <p class="writing-card-title">{entry.data.title}</p>
        </div>
      </div>
    ))}

    {personalItems.filter((item) => item.type === "image").map((item) => (
      <div
        class="grid-item"
        data-id={item.id}
        data-tags={(item.tags || []).join(",")}
        data-type={item.type}
      >
        {item.width && item.height ? (
          <Image
            src={item.src}
            width={item.width}
            height={item.height}
            widths={[480, 768, 1200, 1800]}
            sizes="(max-width: 680px) 100vw, 50vw"
            alt={item.description || item.title}
            loading="lazy"
            class="thumb thumb--portrait"
          />
        ) : (
          <img
            src={item.src}
            alt={item.description || item.title}
            loading="lazy"
            class="thumb thumb--portrait"
          />
        )}
        <p class="label">{item.title}</p>
      </div>
    ))}
  </div>

  <div class="detail" id="detail" style="display: none;">
    <button class="detail-close" id="detail-close">&times;</button>
    <div class="detail-content" id="detail-content"></div>
  </div>
</Base>

<script is:inline>
  (function () {
    var filters = document.getElementById("filters");
    var grid = document.getElementById("grid");
    var detail = document.getElementById("detail");
    var detailContent = document.getElementById("detail-content");
    var detailClose = document.getElementById("detail-close");

    var activeFilter = null;

    filters?.addEventListener("click", function (e) {
      var btn = e.target;
      if (btn.tagName !== "BUTTON") return;
      filters.querySelectorAll("button").forEach(function (b) {
        b.setAttribute("aria-pressed", "false");
      });
      btn.setAttribute("aria-pressed", "true");
      activeFilter = btn.dataset.filter === "all" ? null : btn.dataset.tag;
      grid.querySelectorAll(".grid-item").forEach(function (el) {
        var tags = (el.dataset.tags || "").split(",");
        el.style.display = !activeFilter || tags.includes(activeFilter) ? "" : "none";
      });
    });

    grid?.addEventListener("click", function (e) {
      if (e.target.closest(".detail")) return;
      var el = e.target.closest(".grid-item");
      if (!el || el.dataset.type !== "writing") return;

      var excerpt = el.dataset.excerpt || "";
      var slug = el.dataset.slug || "";
      var html = "";
      if (excerpt) html += '<p class="detail-meta">' + excerpt + '</p>';
      html += '<a class="detail-project-link" href="/writing/' + slug + '">Read essay</a>';
      detailContent.innerHTML = html;
      el.appendChild(detail);
      detail.style.display = "";
      el.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });

    detailClose?.addEventListener("click", function () {
      detail.style.display = "none";
    });
  })();
</script>
