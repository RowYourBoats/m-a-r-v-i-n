# Dependencies
node_modules/

# Build output
dist/
.vercel/
.astro/

# Images (hosted on Vercel Blob, not in git) — but keep .md files so essays
# and _project.md frontmatter sit alongside their images and still ship in code.
public/images/**/*
!public/images/**/
!public/images/**/*.md

# Bullets template
src/content/bullets/_template.md

# Generated manifest archive
src/data/manifest.archive.json

# Dev-only admin tooling (image tagging portal — runs under `astro dev`)
src/pages/admin/
src/pages/api/admin/

# Migration script backups
public/images/image_catalogue.json.bak.*

# Large media / excluded assets
_exclude/

# Local-only archive of spent migrations / stale artifacts (see _DEPRECATED/README.md)
_DEPRECATED/

# Chroma database
chroma/

# Personal evaluations
public/evaluations/

# Environment variables
.env
.env.*

# Local settings
.claude/

